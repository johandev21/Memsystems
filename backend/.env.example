# Server Configuration
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memsystems

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key

# Local Storage Configuration (Default in Dev Mode)
DEV_STORAGE_DIR=./dev-storage
DEV_STORAGE_PUBLIC_URL=http://localhost:4000
DEV_STORAGE_TOKEN_SECRET=dev_secret_change_me_in_prod

# S3 Storage Configuration (Optional)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=memsystems-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
