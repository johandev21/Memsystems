# Server Configuration
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memsystems

# Local Storage Configuration (Default in Dev Mode)
DEV_STORAGE_DIR=./dev-storage
DEV_STORAGE_PUBLIC_URL=http://localhost:4000
DEV_STORAGE_TOKEN_SECRET=dev_secret_change_me_in_prod

# S3 Storage Configuration (Optional)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=memsystems-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# Vercel AI Gateway (optional — used only for background model-catalog syncs).
# Get one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway
# Inference and embeddings always use each user's own gateway key from
# Settings. The chat model catalog syncs from the gateway every 6 hours
# (cron) plus once at startup; without this key the app serves a curated
# seed catalog until a signed-in user refreshes the list.
# AI_GATEWAY_API_KEY=ag_live_...

# Encrypts per-user gateway keys at rest (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...
