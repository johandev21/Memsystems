# ---------------------------------------------------------------------------
# Memsystems backend — copy to `.env.local` for native development.
# Docker injects the equivalent values through Compose; use
# `.env.docker.dev.example` / `.env.docker.prod.example` for that path.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
# Browser origin allowed by CORS.
CLIENT_URL=http://localhost:3000

# --- Database (PostgreSQL + Drizzle ORM) ----------------------------------
# Required. Docker Compose assembles this from POSTGRES_* instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memsystems

# --- Storage --------------------------------------------------------------
# Local disk storage is the default in development.
DEV_STORAGE_DIR=./dev-storage
# Public base URL used to build download links; must be reachable by the browser.
DEV_STORAGE_PUBLIC_URL=http://localhost:4000
# Signs local download links. Use a random 32+ character value in production;
# rotating it invalidates any outstanding links.
DEV_STORAGE_TOKEN_SECRET=dev_secret_change_me_in_prod

# Optional S3-compatible storage (S3, R2, MinIO). When S3_ENDPOINT is set,
# local disk storage is disabled and the values below take over.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=memsystems-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# --- AI providers ---------------------------------------------------------
# The app stores the AI Gateway and Voyage keys from Settings. The variables
# below are optional server-side fallbacks; a key saved in Settings always wins.
#
# AI_GATEWAY_API_KEY powers background model-catalog syncs. Without it the app
# serves a curated seed catalog until the model list is refreshed with the
# stored key.
# AI_GATEWAY_API_KEY=vck_...
#
# VOYAGE_API_KEY is the fallback for embeddings (voyage-4, 1024 dimensions).
# VOYAGE_API_KEY=pa-...

# Encrypts stored keys at rest. Required to save a key from Settings.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...

# --- Crawler (Firecrawl Cloud — the only provider) ------------------------
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Required for web ingestion; get one at https://firecrawl.dev.
# FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_TIMEOUT_MS=30000
