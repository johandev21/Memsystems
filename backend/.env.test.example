# Copy to `.env.test` to run the backend test suite (`pnpm run test`).
# Point DATABASE_URL at a disposable PostgreSQL instance with the pgvector
# extension available; tests truncate tables and create the schema they need.
# `pnpm run test:db:setup` creates the database if it does not exist.
DATABASE_URL=postgresql://postgres:postgres@localhost:5499/memsystems_test
