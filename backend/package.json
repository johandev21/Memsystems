{
  "name": "backend",
  "version": "0.0.1",
  "description": "Memsystems NestJS API Backend",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "dev": "nest start --watch --no-shell",
    "start": "nest start",
    "start:dev": "nest start --watch --no-shell",
    "start:debug": "nest start --debug --watch --no-shell",
    "start:prod": "node dist/main",
    "db:migrate": "ts-node src/database/migrate.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:setup": "ts-node tests/ensure-test-db.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.29",
    "@ai-sdk/deepseek": "^3.0.21",
    "@ai-sdk/google": "^4.0.33",
    "@ai-sdk/openai": "^3.0.74",
    "@ai-sdk/openai-compatible": "^3.0.22",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@clerk/express": "^2.1.64",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "ai": "^6.0.206",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^26.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
