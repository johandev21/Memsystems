# Copy this file to .env.docker.prod before running pnpm docker:prod.
# APP_ORIGIN is the exact browser-facing origin (no trailing slash). Keep it in
# sync with APP_PORT for local use, or replace it with the deployed HTTPS origin.
APP_PORT=3000
API_PORT=4000
DB_PORT=5434
APP_ORIGIN=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=memsystems

CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key
DEV_STORAGE_TOKEN_SECRET=

# Vercel AI Gateway (optional — background model-catalog syncs only).
# Inference and embeddings always use each user's own gateway key from
# Settings. Without this key the app serves a curated seed catalog until a
# signed-in user refreshes the list.
# AI_GATEWAY_API_KEY=ag_live_...

# Encrypts per-user gateway keys at rest (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...
