# Copy this file to .env.docker.prod before running pnpm docker:prod.
# APP_ORIGIN is the exact browser-facing origin (no trailing slash). Keep it in
# sync with APP_PORT for local use, or replace it with the deployed HTTPS origin.
APP_PORT=3000
API_PORT=4000
DB_PORT=5434
APP_ORIGIN=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=memsystems

DEV_STORAGE_TOKEN_SECRET=

# Vercel AI Gateway (optional — background model-catalog syncs only).
# Inference and embeddings use the app-wide gateway key from Settings.
# Without this server key the app serves a curated seed catalog until the
# model list is refreshed with the app-wide key.
# AI_GATEWAY_API_KEY=ag_live_...

# Encrypts the app-wide gateway key at rest (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...

# Crawler (Firecrawl Cloud — the only provider).
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Get a key at https://firecrawl.dev (required).
# FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_TIMEOUT_MS=30000
