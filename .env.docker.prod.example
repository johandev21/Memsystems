# ---------------------------------------------------------------------------
# Docker production-like stack — copy to `.env.docker.prod` before running.
# `pnpm docker:prod` refuses to start until every required value is set.
# Generate each secret independently with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

# --- Ports and public origin ----------------------------------------------
APP_PORT=3000
API_PORT=4000
DB_PORT=5434
# Exact browser-facing origin, no trailing slash. Local default; replace with
# the deployed HTTPS origin for a real deployment.
APP_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
# Hex is required: arbitrary punctuation would break the DATABASE_URL Compose
# assembles from these values.
POSTGRES_PASSWORD=
POSTGRES_DB=memsystems

# --- Required secrets (blank until generated) -----------------------------
# Signs local download links. At least 32 characters.
DEV_STORAGE_TOKEN_SECRET=
# Encrypts stored AI keys at rest. At least 32 characters.
CREDENTIALS_ENCRYPTION_KEY=

# --- AI providers (optional server-side fallbacks) ------------------------
# A key saved in Settings always wins. Without a gateway key the app serves a
# curated seed model catalog until the list is refreshed.
# AI_GATEWAY_API_KEY=vck_...
# VOYAGE_API_KEY=pa-...

# --- Crawler (Firecrawl Cloud — required for web ingestion) ---------------
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_TIMEOUT_MS=30000

# --- Retrieval ------------------------------------------------------------
# Minimum cosine similarity for a chunk to serve as Evidence. Candidates
# below the floor are dropped; when nothing clears it, Chat answers with
# the no-evidence reply instead of a general-knowledge answer.
# Default: 0.3.
# RETRIEVAL_RELEVANCE_FLOOR=0.3
