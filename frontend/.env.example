# Frontend environment variables.
#
# These are read by Vite's dev-server config from the *process* environment
# (your shell or the Docker container). Vite's own .env loading only exposes
# `VITE_`-prefixed keys to `import.meta.env` in browser code; it does not feed
# `process.env` inside `vite.config.ts`, so a local `.env.local` will NOT
# override the values below.
#
# Native development uses the defaults and needs no configuration. The Docker
# dev stack sets VITE_HOST / VITE_USE_POLLING / VITE_POLLING_INTERVAL for you
# (see compose.dev.yml).

# Dev-server bind host. Use 0.0.0.0 to expose the server beyond localhost.
# Default: 127.0.0.1
VITE_HOST=127.0.0.1

# Target for the /api dev proxy (the NestJS backend). Not VITE_-prefixed — it is
# only read server-side by the dev proxy, never shipped to the browser.
# Default: http://127.0.0.1:4000
NESTJS_BACKEND_URL=http://127.0.0.1:4000

# Poll-based file watching. Needed on bind mounts where native filesystem
# events are unreliable (Docker Desktop, WSL, some VMs). Off by default.
VITE_USE_POLLING=false
VITE_POLLING_INTERVAL=500
