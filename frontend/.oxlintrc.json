{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["react","typescript","oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "[--bg:linear-gradient(90deg,var(--transparent)_calc(50%-var(--spread)),var(--color-background),var(--transparent)_calc(50%+var(--spread)))]",
          "[--color-foreground:var(--color-muted-foreground)]",
          "[--typeset-size:1em]",
          "[-webkit-mask-image:var(--logo-mask)]",
          "[-webkit-mask-image:var(--model-mask)]",
          "[-webkit-mask-position:center]",
          "[-webkit-mask-repeat:no-repeat]",
          "[-webkit-mask-size:contain]",
          "[background-repeat:no-repeat,padding-box]",
          "[background:var(--tg-bg)]",
          "[contain-intrinsic-size:auto_200px]",
          "[content-visibility:auto]",
          "[counter-increment:line_0]",
          "[counter-reset:line]",
          "[mask-image:var(--logo-mask)]",
          "[mask-image:var(--model-mask)]",
          "[mask-position:center]",
          "[mask-repeat:no-repeat]",
          "[mask-size:contain]",
          "animate-[source-progress_1.5s_ease-in-out_infinite]",
          "backdrop-blur-[6px]",
          "before:[counter-increment:line]",
          "bg-[length:250%_100%,auto]",
          "bottom-[14%]",
          "bottom-[20%]",
          "content-[counter(line)]",
          "grid-cols-[1fr_320px]",
          "group-[.is-user]:[--color-border:color-mix(in_oklab,var(--primary-foreground)_20%,transparent)]",
          "group-[.is-user]:[--color-foreground:var(--primary-foreground)]",
          "group-[.is-user]:[--color-muted-foreground:color-mix(in_oklab,var(--primary-foreground)_60%,transparent)]",
          "group-[.is-user]:[--color-muted:color-mix(in_oklab,var(--primary-foreground)_8%,transparent)]",
          "group-[.is-user]:[--color-ring:var(--primary-foreground)]",
          "group-[.is-user]:[--selection-background:var(--primary-foreground)]",
          "group-[.is-user]:[--selection-foreground:var(--primary)]",
          "h-[100dvh]",
          "h-[159.5px]",
          "h-[168.5px]",
          "h-[min(520px,calc(100dvh-160px))]",
          "h-[min(680px,calc(100dvh-180px))]",
          "h-[var(--tree-row-height)]",
          "left-[11.5px]",
          "left-[12%]",
          "left-[19.5px]",
          "left-[4%]",
          "left-[8%]",
          "max-h-[38dvh]",
          "max-h-[45vh]",
          "max-h-[50vh]",
          "max-h-[75vh]",
          "max-h-[85vh]",
          "max-h-[90vh]",
          "max-h-[calc(100dvh-1rem)]",
          "max-h-[calc(100dvh-2rem)]",
          "max-w-[37em]",
          "max-w-[55vw]",
          "max-w-[60vw]",
          "max-w-[68ch]",
          "max-w-[72vw]",
          "max-w-[95%]",
          "max-w-[calc(100%-1.5rem)]",
          "max-w-[calc(100%-1rem)]",
          "max-w-[calc(100%_-_12px)]",
          "max-w-[min(18rem,calc(100vw-2rem))]",
          "max-w-[min(18rem,calc(100vw-7rem))]",
          "min-h-[var(--tree-header-min-height)]",
          "min-w-[3.25rem]",
          "pb-[max(0.5rem,env(safe-area-inset-bottom))]",
          "pb-[max(1.25rem,env(safe-area-inset-bottom))]",
          "right-[10%]",
          "right-[12%]",
          "right-[4%]",
          "rounded-[16px]",
          "rounded-[20px]",
          "rounded-[28px]",
          "rounded-[min(var(--radius-4xl),24px)]",
          "scale-[0.99]",
          "shadow-[0_8px_24px_oklch(0_0_0/0.14)]",
          "shadow-[0_8px_24px_oklch(0_0_0/0.35)]",
          "shadow-[var(--composer-glow),0_4px_16px_rgb(0_0_0/0.12)]",
          "shadow-[var(--composer-glow),0_6px_20px_rgb(0_0_0/0.14)]",
          "shadow-[var(--composer-glow),inset_0_1px_0_var(--composer-highlight),0_16px_44px_-28px_var(--composer-shadow)]",
          "shadow-[var(--composer-glow),inset_0_1px_0_var(--composer-highlight),0_18px_48px_-26px_var(--composer-shadow)]",
          "shadow-[var(--composer-glow),inset_0_1px_0_var(--composer-highlight)]",
          "size-[var(--tree-icon-size)]",
          "top-[12%]",
          "top-[18%]",
          "top-[43.5px]",
          "top-[48%]",
          "top-[92.5px]",
          "transition-[background-color,border-color,box-shadow]",
          "transition-[background-color,box-shadow,transform]",
          "transition-[background-color,color,box-shadow]",
          "transition-[background-color,color]",
          "transition-[border-color,box-shadow]",
          "transition-[object-position]",
          "transition-[opacity,background-color]",
          "transition-[width]",
          "w-[60%]",
          "w-[65%]",
          "w-[85%]",
          "w-[90%]",
          "w-[92%]",
          "w-[94%]",
          "w-[95%]",
          "w-[96%]",
          "w-[min(22rem,calc(100vw-2rem))]"
        ]
      }
    ],
    "shadcn/no-inline-styles": [
      "error",
      {
        "allow": [
          "--scheme-*",
          "--tg-*"
        ]
      }
    ],
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "library-artwork",
          "library-artwork__folder-title",
          "library-artwork__title-editor",
          "library-artwork__title-input",
          "library-folder-card",
          "library-grid",
          "library-inline-editable",
          "library-inline-editable__input",
          "library-inline-editable__sizer",
          "library-notebook-card",
          "library-notebook-card--dragging",
          "library-notebook-preview",
          "library-notebook-surface",
          "library-notebook-title-input",
          "notebook-library",
          "roadmap-description",
          "roadmap-view",
          "is-user",
          "is-assistant",
          "custom-conversation",
          "custom-content"
        ]
      }
    ],
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
