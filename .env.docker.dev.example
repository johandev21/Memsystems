# ---------------------------------------------------------------------------
# Docker development stack — copy to `.env.docker.dev` to customize.
# `pnpm docker:dev` falls back to these disposable defaults when the private
# file is absent.
# ---------------------------------------------------------------------------

# --- Ports and public origin ----------------------------------------------
APP_PORT=3000
API_PORT=4000
DB_PORT=5433
# Exact browser-facing origin, no trailing slash. Keep in sync with APP_PORT.
APP_ORIGIN=http://localhost:3000

# --- Database (development-only credentials) ------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=superuser
POSTGRES_DB=memsystems_dev

# --- Secrets --------------------------------------------------------------
# Signs local download links. Disposable; do not reuse outside development.
DEV_STORAGE_TOKEN_SECRET=dev-only-storage-token-secret-change-me
# Encrypts stored AI keys at rest. Disposable; replace to persist your own.
CREDENTIALS_ENCRYPTION_KEY=dev-only-encryption-secret-change-me

# --- AI providers (optional server-side fallbacks) ------------------------
# A key saved in Settings always wins. Without a gateway key the app serves a
# curated seed model catalog until the list is refreshed.
# AI_GATEWAY_API_KEY=vck_...
# VOYAGE_API_KEY=pa-...

# --- Crawler (Firecrawl Cloud — required for web ingestion) ---------------
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_TIMEOUT_MS=30000

# --- Chunking and embeddings ----------------------------------------------
# Token-based chunk sizing (Voyage tokens, ~4 characters each). Sizing is
# part of the chunk representation: tuning these values does not reindex
# existing Sources by itself. Bump CHUNKING_VERSION in chunking.service.ts
# and let the reindex-all job rebuild the corpus.
# Defaults: 320 target, 96 minimum, 48 overlap.
# CHUNK_TARGET_TOKENS=320
# CHUNK_MIN_TOKENS=96
# CHUNK_OVERLAP_TOKENS=48
#
# Contextualized chunk embeddings are the primary document path
# (voyage-context-4, 1024 dimensions). If the key cannot use the contextual
# model, a boot-time capability probe flips the whole process to the
# fallback and the reindex-all rebuilds the corpus with it. Set
# EMBEDDING_CONTEXTUAL_ENABLED=false to select the per-chunk voyage-4 path
# explicitly.
# EMBEDDING_CONTEXTUAL_ENABLED=true
# EMBEDDING_CONTEXTUAL_MODEL=voyage-context-4

# --- Retrieval ------------------------------------------------------------
# Minimum cosine similarity for a chunk to serve as Evidence. Candidates
# below the floor are dropped; when nothing clears the floor, Chat answers
# with the no-evidence reply instead of a general-knowledge answer. The floor
# gates Evidence when reranking is disabled or unavailable; a reranked
# Evidence set is gated by RETRIEVAL_RERANK_THRESHOLD instead.
# Default: 0.3.
# RETRIEVAL_RELEVANCE_FLOOR=0.3
#
# Cross-encoder reranking refines the candidate order with the Voyage
# reranker before Evidence is selected. Set RETRIEVAL_RERANK_ENABLED=false to
# fall back to the fused order, or point RETRIEVAL_RERANK_MODEL at
# `rerank-2.5-lite` for a cheaper model.
# Defaults: enabled true, model rerank-2.5, candidate depth 32, threshold 0.4,
# top-k 8.
# RETRIEVAL_RERANK_ENABLED=true
# RETRIEVAL_RERANK_MODEL=rerank-2.5
# RETRIEVAL_CANDIDATE_DEPTH=32
# RETRIEVAL_RERANK_THRESHOLD=0.4
# RETRIEVAL_TOP_K=8
#
# Hybrid retrieval runs a dense nearest-neighbour search and a lexical
# full-text search as separate candidate lists, over-fetches from each, and
# fuses them with Reciprocal Rank Fusion. Set RETRIEVAL_HYBRID_ENABLED=false
# to fall back to dense-only retrieval. RETRIEVAL_RRF_K is the fusion
# smoothing constant; the leg weights (0..1) tune how much each list
# contributes. The per-leg depth overrides fall back to
# RETRIEVAL_CANDIDATE_DEPTH.
# Defaults: enabled true, k 60, weights 1, depths 32.
# RETRIEVAL_HYBRID_ENABLED=true
# RETRIEVAL_RRF_K=60
# RETRIEVAL_RRF_DENSE_WEIGHT=1
# RETRIEVAL_RRF_LEXICAL_WEIGHT=1
# RETRIEVAL_DENSE_CANDIDATE_DEPTH=32
# RETRIEVAL_LEXICAL_CANDIDATE_DEPTH=32

# Query understanding rewrites the user message into a search query before
# the retrieval legs run: it strips tone, length, and format instructions,
# resolves follow-up references from the recent chat turns, and can
# paraphrase short or ambiguous questions. The rewrite model is a gateway
# chat model. The stage is skipped when the message already reads as a
# search query, and degrades to a deterministic heuristic when the model is
# unavailable, exceeds RETRIEVAL_REWRITE_TIMEOUT_MS, or fails.
# Defaults: enabled true, model openai/gpt-4o-mini, timeout 1200ms,
# multi-query on with 2 paraphrases, hypothetical answers off.
# RETRIEVAL_REWRITE_ENABLED=true
# RETRIEVAL_REWRITE_MODEL=openai/gpt-4o-mini
# RETRIEVAL_REWRITE_TIMEOUT_MS=1200
# RETRIEVAL_REWRITE_MULTI_QUERY=true
# RETRIEVAL_REWRITE_VARIANT_COUNT=2
# RETRIEVAL_REWRITE_HYPOTHETICAL_ANSWER=false

# --- Evidence assembly ----------------------------------------------------
# The candidates that clear the threshold are assembled into the model-facing
# Evidence set: overlapping passages collapse to the best-ranked one
# (RETRIEVAL_OVERLAP_THRESHOLD is the containment share above which a passage
# counts as an overlap), one Source cannot fill the set
# (RETRIEVAL_MAX_PER_SOURCE; 0 disables the cap, and candidates the cap
# excludes backfill when the set is not full), and selected passages carry
# their section heading path (RETRIEVAL_SECTION_EXPANSION). The set is bounded
# by RETRIEVAL_EVIDENCE_TOKEN_BUDGET estimated tokens, so Assembly stops
# adding passages rather than slicing the context by characters.
# Defaults: enabled true, overlap 0.8, max per source 4, budget 20000,
# section expansion on.
# RETRIEVAL_EVIDENCE_ENABLED=true
# RETRIEVAL_OVERLAP_THRESHOLD=0.8
# RETRIEVAL_MAX_PER_SOURCE=4
# RETRIEVAL_EVIDENCE_TOKEN_BUDGET=20000
# RETRIEVAL_SECTION_EXPANSION=true

# --- Dev server tuning ----------------------------------------------------
# Polling is reliable for Docker Desktop bind mounts; raise to reduce CPU use.
VITE_POLLING_INTERVAL=500
