# Docker development ports and public browser origin
APP_PORT=3000
API_PORT=4000
DB_PORT=5433
APP_ORIGIN=http://localhost:3000

# Development-only database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=superuser
POSTGRES_DB=memsystems_dev

# Disposable local secret; do not reuse outside development
DEV_STORAGE_TOKEN_SECRET=dev-only-storage-token-secret-change-me

# Polling is reliable for Docker Desktop bind mounts; raise this to reduce CPU use
VITE_POLLING_INTERVAL=500

# Vercel AI Gateway (optional — background model-catalog syncs only).
# Inference and embeddings use the app-wide gateway key from Settings.
# Without this server key the app serves a curated seed catalog until the
# model list is refreshed with the app-wide key.
# AI_GATEWAY_API_KEY=ag_live_...

# Encrypts the app-wide gateway key at rest (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...
