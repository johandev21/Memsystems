# Docker development ports and public browser origin
APP_PORT=3000
API_PORT=4000
DB_PORT=5433
APP_ORIGIN=http://localhost:3000

# Development-only database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=superuser
POSTGRES_DB=memsystems_dev

# Disposable local secrets; do not reuse outside development
CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key
DEV_STORAGE_TOKEN_SECRET=dev-only-storage-token-secret-change-me

# Polling is reliable for Docker Desktop bind mounts; raise this to reduce CPU use
VITE_POLLING_INTERVAL=500

# Vercel AI Gateway (optional — background model-catalog syncs only).
# Inference and embeddings always use each user's own gateway key from
# Settings. Without this key the app serves a curated seed catalog until a
# signed-in user refreshes the list.
# AI_GATEWAY_API_KEY=ag_live_...

# Encrypts per-user gateway keys at rest (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=...
